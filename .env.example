# Example local values only. Copy to an untracked .env or export in your shell.
OREAMY_DB_URL=jdbc:postgresql://localhost:5432/pettale
OREAMY_DB_USERNAME=pettale
OREAMY_DB_PASSWORD=replace-with-a-local-password
OREAMY_APPLE_AUDIENCE=com.oreamy.app
OREAMY_APPLE_ISSUER=https://appleid.apple.com
OREAMY_APPLE_JWK_SET_URI=https://appleid.apple.com/auth/keys
OREAMY_APPLE_CERTIFICATE_ONLINE_CHECKS=true
OREAMY_SESSION_ISSUER=oreamy-backend
OREAMY_SESSION_LIFETIME=P30D
# Generate at least 32 random bytes and provide them as Base64. Never commit the real value.
OREAMY_SESSION_SIGNING_KEY=replace-with-base64-secret
# Configurable V1 policy: FREE=3 and PREMIUM_TRIAL/PREMIUM=300.
# Local QA may set both values to 1000 without disabling quota enforcement.
OREAMY_AI_FREE_MONTHLY_REQUEST_LIMIT=3
OREAMY_AI_PREMIUM_MONTHLY_REQUEST_LIMIT=300
OREAMY_TRIAL_DURATION=P30D
OREAMY_EXTRACTION_MODEL=gpt-5-mini
OREAMY_EXTRACTION_REASONING_EFFORT=low
OREAMY_EXTRACTION_TEXT_VERBOSITY=low
OREAMY_AI_RESERVATION_TIMEOUT=PT2M
OREAMY_OPENAI_TIMEOUT=PT30S
OREAMY_OPENAI_API_KEY=
# Override only for controlled development/testing; production should use the official HTTPS endpoint.
OREAMY_OPENAI_BASE_URL=https://api.openai.com
