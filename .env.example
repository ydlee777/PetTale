# Example local values only. Copy to an untracked .env or export in your shell.
PETTALE_DB_URL=jdbc:postgresql://localhost:5432/pettale
PETTALE_DB_USERNAME=pettale
PETTALE_DB_PASSWORD=replace-with-a-local-password
PETTALE_APPLE_AUDIENCE=com.pettale.app
PETTALE_APPLE_ISSUER=https://appleid.apple.com
PETTALE_APPLE_JWK_SET_URI=https://appleid.apple.com/auth/keys
PETTALE_SESSION_ISSUER=pettale-backend
PETTALE_SESSION_LIFETIME=P30D
# Generate at least 32 random bytes and provide them as Base64. Never commit the real value.
PETTALE_SESSION_SIGNING_KEY=replace-with-base64-secret
# Production/default policy remains 25. Override to 1000 only in an untracked local .env for development QA.
PETTALE_AI_MONTHLY_REQUEST_LIMIT=25
PETTALE_EXTRACTION_MODEL=gpt-5-mini
PETTALE_EXTRACTION_REASONING_EFFORT=low
PETTALE_EXTRACTION_TEXT_VERBOSITY=low
PETTALE_AI_RESERVATION_TIMEOUT=PT2M
PETTALE_OPENAI_TIMEOUT=PT30S
PETTALE_OPENAI_API_KEY=
# Override only for controlled development/testing; production should use the official HTTPS endpoint.
PETTALE_OPENAI_BASE_URL=https://api.openai.com
