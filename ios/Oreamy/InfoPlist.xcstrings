    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Oreamy connects to your local development server while the app is under development."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개발 중 Oreamy가 로컬 개발 서버에 연결하기 위해 네트워크 접근을 사용합니다."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oreamy uses the microphone to turn your voice into your pet's daily record."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oreamy는 음성을 반려동물의 일상 기록으로 만들기 위해 마이크를 사용합니다."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oreamy transcribes your voice note on your device so you can review your pet's daily record."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oreamy는 반려동물의 일상 기록을 검토할 수 있도록 기기에서 음성 메모를 받아씁니다."
          }
        }
      }
    }
