          "stringUnit" : {
            "state" : "translated",
            "value" : "Pettale transcribes your voice note on your device so you can review your pet's daily record."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pettale은 반려동물의 일상 기록을 검토할 수 있도록 기기에서 음성 메모를 받아씁니다."
